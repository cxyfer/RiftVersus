# Copy this file to .env and replace every local placeholder before deployment.
POSTGRES_USER=riftversus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=riftversus
DATABASE_URL=postgresql://riftversus:change-me@postgres:5432/riftversus

MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# Configure all S3 variables together, or leave all of them unset.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=riftversus
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true
# Local Compose only. Remote buckets must be provisioned out-of-band.
S3_AUTO_CREATE_BUCKET=true

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
SYNC_CRON=0 3 * * *
SYNC_TIMEZONE=UTC
# Required: use the currently reviewed official API endpoint. Verify it with
# the bounded probes in docs/operations.md before every deployment.
LEAGUEPEDIA_ENDPOINT=https://replace-with-reviewed-leaguepedia-host.example/api.php
LEAGUEPEDIA_USER_AGENT=RiftVersus/0.1 (+https://your-deployment.example; ops@your-domain.example)
LEAGUEPEDIA_REQUEST_INTERVAL_MS=1000
LEAGUEPEDIA_SYNC_YEARS=2023,2024
LEAGUEPEDIA_SYNC_COMPETITIONS=Worlds
LEAGUEPEDIA_COMPETITION_MAP={"Worlds":{"2023":"Worlds 2023 Main Event","2024":"Worlds 2024 Main Event"}}
# Exact image hosts observed during the reviewed probe, comma-separated.
LEAGUEPEDIA_MEDIA_HOSTS=replace-with-reviewed-media-host.example
LEAGUEPEDIA_OVERRIDES_DIR=data/overrides
LEAGUEPEDIA_FIXTURE_PATH=data/fixtures/leaguepedia-small.json
LEAGUEPEDIA_MAX_BYTES=100000000
LEAGUEPEDIA_MAX_PAGES=2000
LEAGUEPEDIA_MAX_ROWS=500000
LEAGUEPEDIA_MAX_REVIEWED_PAGES=5000
MEDIA_DELIVERY=proxy
