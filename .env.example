# Copy this file to .env and replace local placeholders before deployment.
DATABASE_URL=postgresql://riftversus:change-me@localhost:5432/riftversus

# Configure all S3 variables together, or leave all of them unset.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=riftversus
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
SYNC_CRON=0 3 * * *
SYNC_TIMEZONE=UTC
LEAGUEPEDIA_ENDPOINT=https://lol.fandom.com/api.php
LEAGUEPEDIA_USER_AGENT=RiftVersus/0.1 (https://github.com/riftversus; contact@example.invalid)
LEAGUEPEDIA_SYNC_YEARS=2023,2024
LEAGUEPEDIA_SYNC_COMPETITIONS=Worlds
LEAGUEPEDIA_COMPETITION_MAP={"Worlds":{"2023":"2023 Season World Championship","2024":"2024 Season World Championship"}}
LEAGUEPEDIA_MEDIA_HOSTS=static.wikia.nocookie.net
LEAGUEPEDIA_OVERRIDES_DIR=data/overrides
LEAGUEPEDIA_FIXTURE_PATH=data/fixtures/leaguepedia-small.json
LEAGUEPEDIA_MAX_BYTES=100000000
LEAGUEPEDIA_MAX_PAGES=2000
LEAGUEPEDIA_MAX_ROWS=500000
MEDIA_DELIVERY=proxy
