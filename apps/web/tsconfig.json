{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@riftversus/api-runtime": ["src/api/static-runtime.ts"],
      "@riftversus/contracts": ["../../packages/contracts/src/index.ts"],
      "@riftversus/domain": ["../../packages/domain/src/index.ts"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/domain" }
  ]
}
